{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexTags AI",
  "mainBinaryName": "NexTags AI",
  "version": "0.1.0",
  "identifier": "br.com.nextagsai.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NexTags",
    "copyright": "© NexTags",
    "category": "Business",
    "homepage": "https://app.nextagsai.com.br/",
    "shortDescription": "NexTags AI Desktop",
    "longDescription": "Aplicativo desktop da NexTags AI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
